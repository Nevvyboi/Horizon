# Copy this file to .env to let BalanceBar talk to the live Investec sandbox.
# The real .env is gitignored. Never commit real credentials.
#
# The sandbox uses ONE shared, public set of credentials that Investec
# publishes in their developer docs, so the values below are safe to use as is
# for the sandbox. For your own profile, swap in the values from the Investec
# developer portal.
#
# These are read only by the Vite dev-server proxy (see vite.config.ts) and by
# the Tauri Rust backend. They are never bundled into the browser code.

INVESTEC_CLIENT_ID=REDACTED
INVESTEC_SECRET=REDACTED
INVESTEC_API_KEY=REDACTED

# The sandbox "Mr Smith" account works out of the box.
INVESTEC_ACCOUNT_ID=3353431574710163189587446

# Which data source the frontend uses on load: "mock" (default, no network) or
# "live" (calls the sandbox through the proxy, falls back to mock on failure).
VITE_DATA_SOURCE=mock

# Optional host overrides. Defaults point at the sandbox. Point these at the
# live hosts (identity.secure.investec.com/connect/token and
# openapi.investec.com) only when you are ready for production.
# INVESTEC_TOKEN_URL=https://openapisandbox.investec.com/identity/v2/oauth2/token
# INVESTEC_API_BASE=https://openapisandbox.investec.com/za/pb/v1
